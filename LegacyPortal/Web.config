<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="PortalDatabase" providerName="System.Data.SqlClient"
         connectionString="Data Source=WORKSHOP_SERVER;Initial Catalog=WORKSHOP_DATABASE;Integrated Security=True;Connect Timeout=5" />
  </connectionStrings>
  <system.web>
    <compilation debug="false" defaultLanguage="c#" />
    <authentication mode="None" />
    <customErrors mode="On" />
    <httpRuntime maxRequestLength="64" executionTimeout="30" />
    <pages enableViewStateMac="true" enableEventValidation="true" viewStateEncryptionMode="Always" validateRequest="true" />
    <machineKey validationKey="AutoGenerate,IsolateApps" decryptionKey="AutoGenerate,IsolateApps"
                validation="SHA1" decryption="AES" />
    <sessionState mode="InProc" cookieless="UseCookies" timeout="20" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8"
                   culture="ja-JP" uiCulture="ja-JP" />
    <trace enabled="false" />
  </system.web>
</configuration>
